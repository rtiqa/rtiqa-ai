# ==============================================================================
# RTIQA Enterprise Platform Environment Configuration (.env.example)
# Comprehensive List of All System Environment Variables & Defaults
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Artificial Intelligence & LLM Service Credentials
# ------------------------------------------------------------------------------
# Google Gemini Pro / Flash API Key for AI Tutoring & RAG Generation
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# 2. Database Engine & Supabase Core (PostgreSQL + pgvector)
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=rtiqa_secure_pass_2026
POSTGRES_DB=rtiqa_db
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# 3. Keycloak Enterprise Identity & Access Management (IAM / OIDC)
# ------------------------------------------------------------------------------
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin_secure_keycloak_2026
KEYCLOAK_PORT=8080

# ------------------------------------------------------------------------------
# 4. Directus Headless Content Management System (Curriculum Platform)
# ------------------------------------------------------------------------------
DIRECTUS_ADMIN_EMAIL=admin@rtiqa.edu
DIRECTUS_ADMIN_PASSWORD=rtiqa_directus_admin_2026
DIRECTUS_KEY=rtiqa-directus-secret-key-2026
DIRECTUS_SECRET=rtiqa-directus-secret-token-2026
DIRECTUS_PORT=8055

# ------------------------------------------------------------------------------
# 5. LiveKit WebRTC Selective Forwarding Unit (SFU Server)
# ------------------------------------------------------------------------------
LIVEKIT_API_KEY=rtiqa_livekit_key
LIVEKIT_API_SECRET=rtiqa_livekit_secret_token_2026_super_secure
LIVEKIT_HTTP_PORT=7880

# ------------------------------------------------------------------------------
# 6. Typesense In-Memory Typo-Tolerant Search Engine
# ------------------------------------------------------------------------------
TYPESENSE_API_KEY=rtiqa_typesense_master_key_2026
TYPESENSE_PORT=8108

# ------------------------------------------------------------------------------
# 7. Qdrant High-Performance Rust Vector Database
# ------------------------------------------------------------------------------
QDRANT_API_KEY=rtiqa_qdrant_secure_key_2026
QDRANT_REST_PORT=6333
QDRANT_GRPC_PORT=6334

# ------------------------------------------------------------------------------
# 8. Ktor Microservice Gateway & Backend Server Options
# ------------------------------------------------------------------------------
KTOR_PORT=8081
KTOR_ENV=development
AUTH_PROVIDER_NAME=Keycloak IAM OIDC
DB_PROVIDER_NAME=Supabase PostgreSQL 15 + pgvector
SEARCH_PROVIDER_NAME=Typesense 26.0
VECTOR_PROVIDER_NAME=Qdrant Rust v1.8.0
MEDIA_PROVIDER_NAME=LiveKit WebRTC SFU v1.6.0
