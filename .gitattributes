# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Explicitly set text files
*.kt text eol=lf
*.kts text eol=lf
*.java text eol=lf
*.xml text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.properties text eol=lf
*.sh text eol=lf

# Binary files
*.png binary
*.jpg binary
*.webp binary
*.jar binary
*.keystore binary
